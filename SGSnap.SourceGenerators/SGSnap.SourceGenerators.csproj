<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <PackageId>SGSnap.SourceGenerators</PackageId>
    <Description>Generator-driver snapshots for SGSnap: renders a source generator run's generated files and diagnostics as snapshot files.</Description>
    <PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>snapshot;testing;xunit;roslyn;source-generators</PackageTags>
    <RepositoryUrl>https://github.com/daemogar/sgsnap</RepositoryUrl>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../README.md" Pack="true" PackagePath="/" />
    <InternalsVisibleTo Include="SGSnap.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../SGSnap/SGSnap.csproj" />
    <PackageReference Include="Microsoft.CodeAnalysis.Common" />
  </ItemGroup>

</Project>
