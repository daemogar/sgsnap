{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "timezone": "America/New_York",
  "schedule": ["before 5am on monday"],
  "separateMajorMinor": false,
  "packageRules": [
    {
      "description": "One combined PR for every dependency across nuget and github-actions.",
      "matchPackageNames": ["*"],
      "groupName": "all dependencies",
      "groupSlug": "all-dependencies",
      "automerge": true
    },
    {
      "description": "xunit.v3 stays on 3.x until the test platform migration is planned.",
      "matchPackageNames": ["xunit.v3", "xunit.v3.extensibility.core"],
      "allowedVersions": "<4.0.0"
    }
  ],
  "platformAutomerge": true,
  "vulnerabilityAlerts": { "automerge": true }
}
